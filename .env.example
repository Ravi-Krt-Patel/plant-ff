# Catalog data remains the existing mock catalog.
NEXT_PUBLIC_DATA_SOURCE=mock
# Set this to the standalone NestJS backend to enable persisted addresses,
# backend checkout and order tracking. Leave empty for the original demo flow.
NEXT_PUBLIC_API_BASE_URL=
# Example: NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
# Public map configuration. Never put secret provider keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION may override the default linked OpenStreetMap attribution.
